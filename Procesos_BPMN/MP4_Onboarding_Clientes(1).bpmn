<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_Onboarding">
    <bpmn:participant id="Participant_Onboarding" name="TrendNova: Onboarding y Registro de Clientes" processRef="Proceso_Onboarding" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Onboarding" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Backend" name="Sistema Core (Backend)">
        <bpmn:flowNodeRef>Task_Enviar_Bienvenida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Crear_Perfil</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Generar_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verificar_Token</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Frontend" name="Portal Web (Frontend)">
        <bpmn:flowNodeRef>Task_Validar_Regex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Valido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_End_Invalido</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Usuario" name="Usuario Visitante">
        <bpmn:flowNodeRef>Event_End_Registrado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ingresar_Token</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Llenar_Formulario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Start_Registro</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="Event_End_Registrado" name="Cliente Activo">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Ingresar_Token" name="Ingresar Código OTP">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Llenar_Formulario" name="Ingresar Datos Personales">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="Event_Start_Registro" name="Inicia Registro">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validar_Regex" name="Validar Formato RUT/Email">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Enviar_Bienvenida" targetRef="Event_End_Registrado" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Crear_Perfil" targetRef="Task_Enviar_Bienvenida" />
    <bpmn:sequenceFlow id="Flow_8_Yes" name="Sí" sourceRef="Gateway_Token" targetRef="Task_Crear_Perfil" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Verificar_Token" targetRef="Gateway_Token" />
    <bpmn:sequenceFlow id="Flow_8_No" name="No (Reintento)" sourceRef="Gateway_Token" targetRef="Task_Generar_Token" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Ingresar_Token" targetRef="Task_Verificar_Token" />
    <bpmn:sequenceFlow id="Flow_4_Yes" name="Sí" sourceRef="Gateway_Valido" targetRef="Task_Generar_Token" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Generar_Token" targetRef="Task_Ingresar_Token" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start_Registro" targetRef="Task_Llenar_Formulario" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Llenar_Formulario" targetRef="Task_Validar_Regex" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Validar_Regex" targetRef="Gateway_Valido" />
    <bpmn:sequenceFlow id="Flow_4_No" name="No" sourceRef="Gateway_Valido" targetRef="Event_End_Invalido" />
    <bpmn:sendTask id="Task_Enviar_Bienvenida" name="Enviar Correo de Bienvenida">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_Crear_Perfil" name="Registrar Cliente en BD">
      <bpmn:incoming>Flow_8_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_06fo25l">
        <bpmn:targetRef>DataStoreReference_0wwbef2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Token" name="¿Token Válido?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_8_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Generar_Token" name="Generar y Enviar Token (OTP)">
      <bpmn:incoming>Flow_4_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Verificar_Token" name="Verificar Identidad">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Valido" name="¿Formato Correcto?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_4_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_End_Invalido" name="Registro Rechazado">
      <bpmn:incoming>Flow_4_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_0wwbef2" name="Cliente" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Onboarding">
      <bpmndi:BPMNShape id="Participant_Onboarding_di" bpmnElement="Participant_Onboarding" isHorizontal="true">
