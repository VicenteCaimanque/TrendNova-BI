<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_LogisticaInversa">
    <bpmn:participant id="Participant_Logistica" name="TrendNova: Logística Inversa y Reembolsos" processRef="Proceso_Logistica" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Logistica" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Cliente" name="Cliente">
        <bpmn:flowNodeRef>Event_End_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Start_Ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_End_Exito</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Portal" name="Portal Digital Postventa">
        <bpmn:flowNodeRef>Task_Validar_Plazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notificar_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Generar_Etiqueta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar_Etiqueta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Calcular_Monto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Actualizar_BD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar_NC</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ejecutivo" name="Ejecutivo de Servicio al Cliente">
        <bpmn:flowNodeRef>Task_Evaluar_Evidencia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Aprobado</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bodega" name="Analista Control Calidad">
        <bpmn:flowNodeRef>Event_Wait_Bulto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Inspeccion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Estado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar_Merma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reingresar_Stock</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pasarela" name="Pasarela Financiera">
        <bpmn:flowNodeRef>Task_Procesar_Reembolso</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:endEvent id="Event_End_Rechazo" name="Ticket Cerrado">
      <bpmn:incoming>Flow_Rechazo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Event_Start_Ticket" targetRef="Task_Validar_Plazo" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Validar_Plazo" targetRef="Task_Evaluar_Evidencia" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Evaluar_Evidencia" targetRef="Gateway_Aprobado" />
    <bpmn:sequenceFlow id="Flow_NO" name="Rechazado" sourceRef="Gateway_Aprobado" targetRef="Task_Notificar_Rechazo" />
    <bpmn:sequenceFlow id="Flow_Rechazo" sourceRef="Task_Notificar_Rechazo" targetRef="Event_End_Rechazo" />
    <bpmn:sequenceFlow id="Flow_YES" name="Aprobado" sourceRef="Gateway_Aprobado" targetRef="Task_Generar_Etiqueta" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Generar_Etiqueta" targetRef="Task_Enviar_Etiqueta" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Enviar_Etiqueta" targetRef="Event_Wait_Bulto" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_Wait_Bulto" targetRef="Task_Inspeccion" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Inspeccion" targetRef="Gateway_Estado" />
    <bpmn:sequenceFlow id="Flow_APTO" name="Apto Venta" sourceRef="Gateway_Estado" targetRef="Task_Reingresar_Stock" />
    <bpmn:sequenceFlow id="Flow_MERMA" name="Falla Fábrica" sourceRef="Gateway_Estado" targetRef="Task_Registrar_Merma" />
    <bpmn:sequenceFlow id="Flow_APTO_Conv" sourceRef="Task_Reingresar_Stock" targetRef="Task_Calcular_Monto" />
    <bpmn:sequenceFlow id="Flow_MERMA_Conv" sourceRef="Task_Registrar_Merma" targetRef="Task_Calcular_Monto" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Calcular_Monto" targetRef="Task_Procesar_Reembolso" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Procesar_Reembolso" targetRef="Task_Actualizar_BD" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Actualizar_BD" targetRef="Task_Enviar_NC" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Enviar_NC" targetRef="Event_End_Exito" />
    <bpmn:startEvent id="Event_Start_Ticket" name="Ingresa Reclamo">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Validar_Plazo" name="Validar Plazo y Elegibilidad">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:property id="Property_1ob6qk1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_18tzn2z">
        <bpmn:sourceRef>DataStoreReference_023fi3d</bpmn:sourceRef>
        <bpmn:targetRef>Property_1ob6qk1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Evaluar_Evidencia" name="Evaluar Evidencia Fotográfica">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Aprobado" name="¿Ticket Válido?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_NO</bpmn:outgoing>
      <bpmn:outgoing>Flow_YES</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_Notificar_Rechazo" name="Notificar Rechazo Fundado">
      <bpmn:incoming>Flow_NO</bpmn:incoming>
      <bpmn:outgoing>Flow_Rechazo</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:scriptTask id="Task_Generar_Etiqueta" name="Generar Retorno Gratuito">
      <bpmn:incoming>Flow_YES</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sendTask id="Task_Enviar_Etiqueta" name="Enviar Etiqueta al Cliente">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_Wait_Bulto" name="Esperar Arribo Físico">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Inspeccion" name="Inspección Física Textil">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Estado" name="¿Diagnóstico?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_APTO</bpmn:outgoing>
      <bpmn:outgoing>Flow_MERMA</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Task_Registrar_Merma" name="Disponer para Destrucción">
      <bpmn:incoming>Flow_MERMA</bpmn:incoming>
      <bpmn:outgoing>Flow_MERMA_Conv</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Task_Reingresar_Stock" name="Re-ingresar a Rack Comercial">
      <bpmn:incoming>Flow_APTO</bpmn:incoming>
      <bpmn:outgoing>Flow_APTO_Conv</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_01ezk1p">
        <bpmn:targetRef>DataStoreReference_0dmoaxr</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_Calcular_Monto" name="Calcular Liquidación Neta">
      <bpmn:incoming>Flow_APTO_Conv</bpmn:incoming>
      <bpmn:incoming>Flow_MERMA_Conv</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_Actualizar_BD" name="Sincronizar Estado BD">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1j7vd3a">
        <bpmn:targetRef>DataStoreReference_06r6sv5</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Procesar_Reembolso" name="Reversar Fondos Bancarios">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStoreReference_023fi3d" name="Orden_Venta" />
    <bpmn:dataStoreReference id="DataStoreReference_0dmoaxr" name="Inventario" />
    <bpmn:sendTask id="Task_Enviar_NC" name="Emitir Nota de Crédito">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_End_Exito" name="Reembolso Completado">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_06r6sv5" name="Orden_Venta" />
  </bpmn:process>
